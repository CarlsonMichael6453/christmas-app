# Public client config for the live Christmas Family project.
# Both values are safe to ship. The publishable key is not a secret.
# Leave them blank to run only on this device (demo mode).
# Copy this file to .env.local for Expo Go. The GitHub Pages build sets the
# same names in .github/workflows/deploy-pages.yml.
#
# Supabase calls the public key the "publishable" key. Older projects label
# the same kind of key "anon". Either name works.

EXPO_PUBLIC_SUPABASE_URL=https://lqkffrqtkykuirarnrkq.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GJGsmtk47WBbzXwn5fPSUg_NJHSjzSK

# EXPO_PUBLIC_SUPABASE_ANON_KEY=
