# Optional. Leave these blank to run entirely on this phone (demo mode).
# When both are set, the app uses Supabase for accounts, groups, wishlists,
# hidden claims, Secret Santa, and the other shared lists.
#
# Supabase calls the public key the "publishable" key. Older projects label
# the same kind of key "anon". Either name works.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# EXPO_PUBLIC_SUPABASE_ANON_KEY=
